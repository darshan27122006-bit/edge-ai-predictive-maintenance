# Edge-AI Predictive Maintenance Environment Configuration
# Copy this file to .env before starting the server

# Database Settings
DATABASE_URL=sqlite:///./predictive_maintenance.db

# Edge Device Security
DEVICE_AUTH_TOKEN=esp32-secret-iot-token-2026

# Alert Flood Protection
ALERT_COOLDOWN_SECONDS=30

# Default Machinery Thresholds (ISO 10816 Class II)
DEFAULT_VIB_WARN_THRESHOLD=2.80
DEFAULT_VIB_CRIT_THRESHOLD=4.50
DEFAULT_TEMP_WARN_THRESHOLD=60.0
DEFAULT_TEMP_CRIT_THRESHOLD=75.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
